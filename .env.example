# Copy this file to .env and fill in your values. pydantic-settings reads it automatically.

# ---- Database (matches docker-compose.yml) ----
DB_URL=postgresql+psycopg://graminsahay:graminsahay@localhost:5432/graminsahay

# ---- LLM for explanations (embeddings run LOCALLY, so no embedding key needed) ----
# Option A: OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# Option B: Groq (free tier). Groq works fine here because we only use it for CHAT;
# embeddings are local.
#
# IMPORTANT: Groq's model catalog changes over time. List the models YOUR key can use with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
# then pick any text model that lists "json_mode" in supported_features.
# Good choices (as of late 2026): openai/gpt-oss-20b (fast) or openai/gpt-oss-120b (stronger).
# OPENAI_API_KEY=gsk-your-groq-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=openai/gpt-oss-20b

# ---- Local embedding model (downloaded once from Hugging Face) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
