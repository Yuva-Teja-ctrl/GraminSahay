# Copy this file to .env and fill in your values. pydantic-settings reads it automatically.

# ---- Database (matches docker-compose.yml) ----
DB_URL=postgresql+psycopg://graminsahay:graminsahay@localhost:5432/graminsahay

# ---- LLM for explanations (embeddings run LOCALLY, so no embedding key needed) ----
# Option A: OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# Option B: Groq (free tier). Groq works fine here because we only use it for CHAT;
# embeddings are local. NOTE: Groq's model catalog changes over time — check the current
# list at https://console.groq.com/docs/models . As of late 2026 the Llama 4 family is live
# (the older llama-3.3-70b-versatile was retired on 2026-08-16).
# OPENAI_API_KEY=gsk-your-groq-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Local embedding model (downloaded once from Hugging Face) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
