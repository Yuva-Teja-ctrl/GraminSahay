# Copy this file to .env and fill in your values. pydantic-settings reads it automatically.

# ---- Database (matches docker-compose.yml) ----
DB_URL=postgresql+psycopg://graminsahay:graminsahay@localhost:5432/graminsahay

# ---- LLM for explanations (embeddings run LOCALLY, so no embedding key needed) ----
# Option A: OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# Option B: Groq (Llama 3.3 70B — the model from your ResuMate project).
# Groq works fine here because we only use it for CHAT; embeddings are local.
# OPENAI_API_KEY=gsk-your-groq-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=llama-3.3-70b-versatile

# ---- Local embedding model (downloaded once from Hugging Face) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
