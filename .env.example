# Copy this file to .env and fill in your values, then:  export $(cat .env | xargs)
# (or set these in your IDE run configuration)

# ---- LLM / Embeddings provider ----
# Option A: OpenAI (simplest — provides BOTH chat and embeddings)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Option B: Groq for chat (Llama 3.3 70B — the model from your ResuMate project)
# NOTE: Groq does NOT serve embeddings, so you still need an embedding provider.
#       Either keep OpenAI for embeddings, or switch to a local transformers model.
# OPENAI_API_KEY=gsk-your-groq-key
# OPENAI_BASE_URL=https://api.groq.com/openai
# CHAT_MODEL=llama-3.3-70b-versatile

# ---- Database (matches docker-compose.yml) ----
DB_USERNAME=graminsahay
DB_PASSWORD=graminsahay
